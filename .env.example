# ─────────────────────────────────────────────
# App secrets (NEVER commit the real .env)
# ─────────────────────────────────────────────

# Session signing key – generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_with_python_secrets

# ─────────────────────────────────────────────
# Google OAuth2 Credentials
# Create a project at https://console.cloud.google.com/
# Enable Gmail API, then create OAuth 2.0 Web Client credentials.
# Add http://localhost:8000/auth/callback as an Authorized Redirect URI.
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ─────────────────────────────────────────────
# Base URL where the backend is hosted (used for CORS and redirect defaults)
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# For single-service production (FastAPI serving dist): FRONTEND_URL=http://localhost:8000

# ─────────────────────────────────────────────
# Database
# Default: SQLite file in backend directory
# ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─────────────────────────────────────────────
# Cookie settings
# Set COOKIE_SECURE=false for local HTTP dev, true in production (HTTPS)
# ─────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─────────────────────────────────────────────
# Real-Time Mail Sync (Part A)
# SYNC_MODE: "poll" for local dev without a public URL (checks history every 15s)
#            "pubsub" for production Google Cloud Pub/Sub push notifications
# ─────────────────────────────────────────────
SYNC_MODE=poll
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-push-topic
GMAIL_WEBHOOK_SECRET=your_shared_webhook_secret_here

# ─────────────────────────────────────────────
# AI Assistant (LiteLLM)
# Model string format supported by LiteLLM (e.g. gemini/gemini-1.5-flash, gpt-4o-mini, claude-3-5-sonnet-20241022, groq/llama-3.3-70b-versatile)
# Provide the corresponding API key for your chosen provider
# ─────────────────────────────────────────────
LLM_MODEL=gemini/gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here


